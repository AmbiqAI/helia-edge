---
import Workbench from '../components/mockups/Workbench.astro';
import '@fontsource-variable/inter';
export function getStaticPaths(){return ['01','02','03','04'].map(variant=>({params:{variant}}));}
const id=Number(Astro.params.variant);
const names=['Open workbench','Model studio','Choose your route','Guided workbench'];
const descriptions=['A spacious, workflow-first landing page.','A compact split layout that puts the code beside the promise.','Starting-point cards lead into the component workbench.','A guided workspace with routes and code in one place.'];
const routes=[{title:'I have data',text:'Prepare inputs, choose a model and build your training workflow.',step:0,meta:'PREPARE → BUILD → TRAIN',icon:'▥'}, {title:'I have a model',text:'Evaluate predictions, preserve weights and explore supported export paths.',step:3,meta:'EVALUATE → SAVE → EXPORT',icon:'◇'}, {title:'I’m building something custom',text:'Compose layers and transforms around your own architecture or objective.',step:1,meta:'COMPOSE → CONFIGURE → EXTEND',icon:'⌘'}];
const features=[['01','Architectures','Configurable model families for signals, images, audio and physiology.','architectures'],['02','Data transforms','Preprocessing and augmentation with explicit training and alignment contracts.','preprocessing'],['03','Training components','Progress callbacks and specialized objectives alongside Keras fit().','training'],['04','Task metrics','Classification and signal-quality metrics, with plotting helpers for inspection.','evaluation']];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={descriptions[id-1]}/><meta name="robots" content="noindex,nofollow"/><title>{names[id-1]} · heliaEDGE mockup {id}</title></head>
<body class={`concept concept-${id}`}>
<div class="review"><a href="/helia-edge/mockups/">← All concepts</a><span>LANDING EXPLORATION</span><nav aria-label="Mockup concepts">{names.map((name,i)=><a href={`/helia-edge/mockups/0${i+1}/`} aria-current={i+1===id?'page':undefined} title={name}>0{i+1}<span>{name}</span></a>)}</nav></div>
<header><a class="brand" href="/helia-edge/">helia<strong>EDGE</strong><span class="brand-dot"></span></a><nav aria-label="Site navigation"><a href="/helia-edge/getting-started/">Getting started</a><a href="/helia-edge/guide/">User guide</a><a href="/helia-edge/examples/">Examples</a><a href="/helia-edge/reference/">Reference</a></nav><button class="theme" aria-label="Toggle color theme" type="button">◐</button></header>
<main>
<div class="intro-layout">
<section class="hero">
<p class="eyebrow">HELIAEDGE / THE EDGE AI TOOLKIT</p>
<h1>{id===1?<>Your next Edge AI model.<br/><em>Piece by piece.</em></>:id===2?<>Small components.<br/><em>Room for your ideas.</em></>:id===3?<>Start where you are.<br/><em>Build what’s next.</em></>:<>Your workflow.<br/><em>Your building blocks.</em></>}</h1>
<p class="lead">{id===1?'Reusable Keras architectures, preprocessing, metrics and training components. Take the pieces you need and make the workflow your own.':id===2?'Build Edge AI models with a toolkit that fits around your Keras workflow, from one signal transform to a complete architecture.':id===3?'Bring your data, an existing model or a new design. heliaEDGE gives you reusable Keras components for the next step.':'Explore the components behind an Edge AI workflow. Choose a starting point, inspect the code and follow it into the guide.'}</p>
<div class="actions"><a class="primary" href="/helia-edge/getting-started/">Get started <span>↗</span></a><a class="outline" href="/helia-edge/reference/">Browse the API</a></div>
<p class="backend-line"><span class="dot"></span>Keras workflows · TensorFlow & PyTorch<span class="fine">Support varies by component</span></p>
</section>
{id===2&&<section class="studio" aria-label="Component workbench"><div class="section-label"><span>THE COMPONENT STUDIO</span><span>01—05</span></div><Workbench layout="vertical"/></section>}
</div>
{id===3&&<section class="routes"><div class="section-heading"><p class="eyebrow">CHOOSE YOUR STARTING POINT</p><h2>What are you working with?</h2></div><div class="route-grid">{routes.map(route=><button type="button" class="route" data-start={route.step} aria-pressed="false"><span class="route-top"><span class="route-icon">{route.icon}</span><span>↗</span></span><h3>{route.title}</h3><p>{route.text}</p><small>{route.meta}</small></button>)}</div></section>}
{id!==2&&<section class="work-section" aria-label="Component workbench"><div class="section-heading"><div><p class="eyebrow">{id===4?'A WORKSPACE FOR YOUR NEXT STEP':'EXPLORE THE TOOLKIT'}</p><h2>{id===4?'Find your way into the code.':'Five stages. Use any of them.'}</h2></div><p>Explore a real API example.<br/>Each component fits into your own code.</p></div>
<div class="workspace">{id===4&&<aside class="route-rail"><span class="eyebrow">START WITH</span>{routes.map(route=><button type="button" class="route" data-start={route.step} aria-pressed="false"><h3>{route.title} <span>↗</span></h3><p>{route.text}</p></button>)}<a class="outline" href="/helia-edge/guide/">See the full guide ↗</a></aside>}<Workbench initial={id===3?0:1}/></div></section>}
<section class="capabilities"><div class="section-heading"><div><p class="eyebrow">BUILT TO WORK TOGETHER</p><h2>{id===2?'Build from a family. Refine with a layer.':'One toolkit. No fixed recipe.'}</h2></div><p>Use a single component or connect a workflow.<br/>Your application owns the data and training recipe.</p></div><div class="feature-grid">{features.map(([num,title,text,slug])=><a class="feature" href={`/helia-edge/guide/${slug}/`}><div class="feature-top"><span>{num}</span><span>↗</span></div><h3>{title}</h3><p>{text}</p></a>)}</div></section>
<section class="backend"><div><p class="eyebrow">CHOOSE YOUR ENVIRONMENT</p><h2>TensorFlow and PyTorch.<br/>Through Keras.</h2></div><div><p>Choose the backend before importing Keras. Portable components and selected training paths span both backends. TensorFlow provides the LiteRT conversion and dataset utilities.</p><div class="actions"><a class="outline" href="/helia-edge/getting-started/backends/">Explore backend support ↗</a><a class="outline" href="/helia-edge/guide/export/">Export a model ↗</a></div></div></section>
<section class="examples"><div class="section-heading"><div><p class="eyebrow">FROM READING TO BUILDING</p><h2>Make your first connection.</h2></div><a class="outline" href="/helia-edge/examples/">All examples ↗</a></div><div class="example-grid"><a href="/helia-edge/getting-started/first-model/"><small>BUILD</small><h3>A small temporal model ↗</h3><p>Configure a TCN and save its architecture.</p></a><a href="/helia-edge/examples/train-cifar-model/"><small>TRAIN</small><h3>A complete training workflow ↗</h3><p>Follow the CIFAR-10 notebook from data to training.</p></a><a href="/helia-edge/examples/custom-model-architecture/"><small>EXTEND</small><h3>An architecture of your own ↗</h3><p>Compose a model from reusable Keras layers.</p></a></div></section>
</main>
<footer><a class="brand" href="/helia-edge/">helia<strong>EDGE</strong></a><p>Part of the Ambiq HELIA AI platform</p><span>Concept 0{id} · {names[id-1]}</span></footer>
<script>
const theme=document.querySelector<HTMLButtonElement>('.theme');
theme?.addEventListener('click',()=>document.documentElement.classList.toggle('dark'));
</script>
<style is:global>
*{box-sizing:border-box}html{--red:#d72f4b;--ink:#202126;--muted:#61636c;--line:#dadce1;--paper:#fff;--soft:#f5f5f7;--wash:#fff3f4;scroll-behavior:smooth}html.dark{--red:#ff637e;--ink:#eeeef2;--muted:#a8aab6;--line:#353740;--paper:#14151a;--soft:#1d1f26;--wash:#251b22;color-scheme:dark}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter Variable',sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}button{font-family:inherit}a,button{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:3px solid var(--red);outline-offset:4px}h1,h2,h3,p{margin-top:0}h1,h2,h3{text-wrap:balance}a{text-decoration:none}button{color:inherit}header{height:88px;max-width:1280px;margin:auto;padding:0 40px;display:flex;align-items:center;gap:36px}header nav{display:flex;gap:28px;margin-left:auto;font-size:13px;font-weight:550}.brand{font-size:24px;letter-spacing:-1px;white-space:nowrap}.brand-dot{display:inline-block;background:var(--red);width:7px;height:7px;border-radius:50%;margin:0 0 3px 5px}.theme{border:1px solid var(--line);border-radius:50%;background:var(--paper);width:32px;height:32px;font-size:20px;cursor:pointer}.review{background:var(--ink);color:var(--paper);padding:10px 32px;display:flex;align-items:center;gap:28px;font-size:11px}.review>span{letter-spacing:1.3px;opacity:.55}.review nav{display:flex;gap:6px;margin-left:auto}.review nav a{padding:7px 10px;border-radius:5px;opacity:.65}.review nav a[aria-current]{background:var(--paper);color:var(--ink);opacity:1}.review nav span{margin-left:7px}main{max-width:1200px;margin:auto;padding:0 32px}.hero{padding:72px 0 52px}.eyebrow{font-size:10px;letter-spacing:1.7px;font-weight:700;color:var(--red);margin-bottom:19px}h1{font-size:clamp(38px,4.8vw,64px);letter-spacing:-2.7px;line-height:1.06;font-weight:650;margin-bottom:26px}em{font-style:normal;color:var(--red)}.lead{font-size:18px;line-height:1.75;max-width:670px;color:var(--muted);margin-bottom:27px}.actions{display:flex;flex-wrap:wrap;gap:12px}.primary,.outline{display:inline-flex;justify-content:center;align-items:center;gap:25px;border-radius:100px;padding:13px 21px;font-size:13px;font-weight:600;border:1px solid var(--line)}.primary{background:var(--ink);border-color:var(--ink);color:var(--paper)}.outline{background:transparent}.primary:hover,.outline:hover{border-color:var(--red)}.backend-line{display:flex;align-items:center;gap:9px;font-size:11px;color:var(--muted);margin:26px 0 0;flex-wrap:wrap}.dot{width:5px;height:5px;border-radius:50%;background:var(--red)}.fine{opacity:.7;margin-left:8px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:25px}.section-heading .eyebrow{margin-bottom:12px}h2{font-size:32px;letter-spacing:-1px;line-height:1.2;margin:0}.section-heading>p{font-size:13px;color:var(--muted);line-height:1.7;margin:0}.work-section{margin:25px 0 80px}.capabilities{padding:45px 0 70px}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.feature{padding:24px;border:1px solid var(--line);border-radius:14px}.feature:hover,.example-grid a:hover{border-color:var(--red)}.feature-top{display:flex;justify-content:space-between;color:var(--red);font-size:12px;margin-bottom:30px}.feature h3{font-size:17px;letter-spacing:-.4px;margin-bottom:12px}.feature p{color:var(--muted);font-size:13px;line-height:1.75;margin:0}.backend{display:grid;grid-template-columns:1fr 1.3fr;gap:60px;padding:42px;background:var(--soft);border:1px solid var(--line);border-radius:18px}.backend p:not(.eyebrow){font-size:14px;line-height:1.8;color:var(--muted)}.backend .outline{font-size:12px}.examples{padding:80px 0}.example-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.example-grid a{border:1px solid var(--line);border-radius:14px;padding:26px}.example-grid small{font-size:10px;letter-spacing:1px;color:var(--red)}.example-grid h3{font-size:17px;margin:22px 0 12px}.example-grid p{font-size:13px;color:var(--muted);line-height:1.7;margin:0}footer{display:flex;align-items:center;gap:25px;border-top:1px solid var(--line);padding:32px max(32px,calc((100vw - 1136px)/2));font-size:12px;color:var(--muted)}footer p{margin:0}footer>span{margin-left:auto}.routes{margin:10px 0 65px}.route-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.route{padding:25px;border:1px solid var(--line);background:var(--paper);border-radius:15px;text-align:left;cursor:pointer}.route:hover,.route[aria-pressed=true]{border-color:var(--red);background:var(--wash)}.route-top{display:flex;justify-content:space-between;color:var(--red);margin-bottom:20px}.route-icon{font-size:25px}.route h3{font-size:19px;letter-spacing:-.4px;margin-bottom:12px}.route p{color:var(--muted);font-size:13px;line-height:1.7}.route small{font-size:9px;letter-spacing:1px;color:var(--red)}.section-label{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;letter-spacing:1px;margin-bottom:14px}.concept-2 main{max-width:1320px}.concept-2 .intro-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:45px;align-items:center;padding:50px 0}.concept-2 .hero{padding:15px 0}.concept-2 h1{font-size:48px}.concept-2 .lead{font-size:16px}.concept-2 .feature-grid{grid-template-columns:repeat(2,1fr)}.concept-2 .feature{display:grid;grid-template-columns:35px 1fr 1.6fr;gap:15px;align-items:start}.concept-2 .feature-top{margin:0}.concept-2 .feature-top span:last-child{display:none}.concept-2 .feature h3{margin:0}.concept-3 .hero{text-align:center;max-width:840px;margin:auto;padding-top:60px}.concept-3 .lead{margin-left:auto;margin-right:auto}.concept-3 .actions,.concept-3 .backend-line{justify-content:center}.concept-3 .work-section{background:var(--soft);padding:32px;border-radius:24px}.concept-4 .hero{padding:55px 0 30px;display:grid;grid-template-columns:1.2fr 1fr;column-gap:50px}.concept-4 .hero .eyebrow{grid-column:1/-1}.concept-4 .hero h1{grid-row:2/5;font-size:52px}.concept-4 .hero .lead{font-size:16px;grid-column:2}.concept-4 .hero .actions,.concept-4 .hero .backend-line{grid-column:2}.concept-4 .workspace{display:grid;grid-template-columns:260px 1fr;gap:20px}.route-rail{display:flex;flex-direction:column;gap:10px}.route-rail>.eyebrow{margin:0 0 4px}.route-rail .route{padding:18px}.route-rail h3{font-size:14px;display:flex;justify-content:space-between}.route-rail p{font-size:12px;margin:0}.route-rail .outline{margin-top:auto;font-size:12px}.concept-4 .workbench .panel{grid-template-columns:1fr}.concept-4 .workbench .explanation{padding:25px;display:grid;grid-template-columns:1fr 1fr;gap:0 25px}.concept-4 .workbench .explanation .eyebrow{grid-column:1/-1}.concept-4 .workbench .explanation h3{font-size:24px}.concept-4 .workbench .explanation p{margin:12px 0}.concept-4 .workbench .outline{justify-self:start}.concept-4 .feature-grid{gap:0}.concept-4 .feature{border-radius:0}.concept-4 .feature:first-child{border-radius:14px 0 0 14px}.concept-4 .feature:last-child{border-radius:0 14px 14px 0}
@media(max-width:1000px){.review nav span{display:none}.review>span{display:none}.concept-2 .intro-layout{grid-template-columns:1fr}.concept-2 .hero{max-width:740px}.feature-grid{grid-template-columns:repeat(2,1fr)}.concept-4 .hero{display:block}.concept-4 .workspace{grid-template-columns:1fr}.route-rail{display:grid;grid-template-columns:repeat(3,1fr)}.route-rail>.eyebrow,.route-rail>.outline{display:none}.backend{gap:30px;padding:30px}header{padding:0 32px;gap:20px}header nav{gap:18px}}
@media(max-width:650px){header{height:72px;padding:0 20px}header nav{display:none}.theme{margin-left:auto}.review{padding:10px 15px;gap:12px}.review nav{gap:3px}.review nav a{padding:6px 10px}main{padding:0 20px}.hero{padding:40px 0 25px}h1,.concept-2 h1,.concept-4 .hero h1{font-size:40px;letter-spacing:-1.8px}.lead{font-size:16px}.fine{width:100%;margin-left:14px}.section-heading{display:block}.section-heading>p{margin-top:15px}h2{font-size:27px}.work-section{margin-bottom:40px}.feature-grid,.example-grid,.route-grid,.route-rail,.concept-2 .feature-grid{grid-template-columns:1fr}.feature{padding:23px}.feature-top{margin-bottom:20px}.backend{grid-template-columns:1fr;gap:22px;padding:24px}.examples{padding:50px 0}.examples .section-heading>.outline{margin-top:20px}.concept-2 .intro-layout{padding:30px 0;gap:30px}.concept-2 .feature{display:block}.concept-2 .feature h3{margin:14px 0}.concept-3 .work-section{padding:18px;margin-inline:-8px}.concept-3 .hero{padding-top:40px}.concept-4 .workbench .explanation{display:block}.concept-4 .feature{border-radius:12px!important;margin-bottom:10px}footer{padding:25px 20px;flex-wrap:wrap}footer>span{width:100%;margin:0}.route-rail .route{padding:17px}.route-rail .route p{display:none}.route-rail .route h3{margin:0}}
html.dark .tabs button[aria-selected=true]{color:#191a20}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</body></html>
