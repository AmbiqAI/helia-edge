---
import '@fontsource-variable/inter';
const cards=[['01','Open workbench','Option 1','A spacious introduction with a full-width, five-stage workbench. The clearest expression of the toolkit.'],['02','Model studio','Option 1','A split hero with a vertical component selector. More compact, with code visible from the first screen.'],['03','Choose your route','Options 1 + 3','Three starting-point cards guide visitors into the workbench. A warmer, newcomer-friendly introduction.'],['04','Guided workbench','Options 1 + 3','Starting points and examples share a single workspace. A denser, practical toolkit experience.']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>heliaEDGE · Landing concepts</title></head><body><main><a class="back" href="/helia-edge/">← Current landing page</a><p class="eyebrow">HELIAEDGE / DESIGN EXPLORATIONS</p><h1>Four ways into<br/>the same toolkit.</h1><p class="intro">Two workbench-led concepts. Two that combine the workbench with a visitor’s starting point. All four use real API excerpts and user-controlled interactions.</p><div class="grid">{cards.map(([id,title,type,description])=><a class="card" href={`/helia-edge/mockups/${id}/`}><div class={`mini mini-${id}`} aria-hidden="true"><div class="headline"></div><div class="subline"></div><div class="blocks"><i></i><i></i><i></i></div><div class="editor"><span></span><span></span><span></span></div></div><div class="content"><small>{type} · CONCEPT {id}</small><h2>{title} <span>↗</span></h2><p>{description}</p><strong>Explore concept {id} →</strong></div></a>)}</div><p class="note">Each concept includes stage tabs, guide links and a light/dark toggle. The comparison bar lets you move between versions.</p></main></body></html>
